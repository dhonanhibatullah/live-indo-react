MASTER_SERVICE_LOGGER_FORMAT=json
MASTER_SERVICE_LOGGER_LEVEL=INFO

MASTER_SERVICE_POSTGRES_HOST=127.0.0.1
MASTER_SERVICE_POSTGRES_PORT=5432
MASTER_SERVICE_POSTGRES_USERNAME=CHANGE_ME
MASTER_SERVICE_POSTGRES_PASSWORD=CHANGE_ME
MASTER_SERVICE_POSTGRES_DATABASE=master_database
# Accepted: disable, allow, prefer, require, verify-ca, verify-full.
MASTER_SERVICE_POSTGRES_SSL_MODE=prefer
MASTER_SERVICE_POSTGRES_MAX_CONNECTIONS=10
MASTER_SERVICE_POSTGRES_CONNECT_TIMEOUT_MS=10000

MASTER_SERVICE_CACHE_MAX_CAPACITY=10000
MASTER_SERVICE_CACHE_INDIVIDUAL_TTL_MS=60000
MASTER_SERVICE_CACHE_LIST_TTL_MS=10000

MASTER_SERVICE_HTTP_ADDR=0.0.0.0:8080
MASTER_SERVICE_GRPC_ADDR=0.0.0.0:8081
MASTER_SERVICE_SHUTDOWN_TIMEOUT_MS=15000
